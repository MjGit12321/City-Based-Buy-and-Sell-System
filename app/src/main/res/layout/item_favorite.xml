<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:background="@drawable/product_card_bg"
    android:padding="12dp">

    <ImageView
        android:id="@+id/ivFavoriteUserIcon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:background="@drawable/circle_outline_bg"
        android:padding="3dp"
        android:src="@drawable/ic_user"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#888888"
        android:contentDescription="Seller profile" />

    <TextView
        android:id="@+id/tvFavoriteUsername"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:text="JohnDoe"
        android:textColor="#888888"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@id/ivFavoriteUserIcon"
        app:layout_constraintStart_toEndOf="@id/ivFavoriteUserIcon"
        app:layout_constraintTop_toTopOf="@id/ivFavoriteUserIcon" />

    <LinearLayout
        android:id="@+id/ratingContainerFav"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toStartOf="@id/ivFavoriteHeart"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@android:drawable/btn_star_big_on"
            app:tint="#FFD700" />

        <TextView
            android:id="@+id/tvFavoriteRating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="4.6"
            android:textColor="#333333"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:id="@+id/ivFavoriteHeart"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_heart_filled"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:contentDescription="Remove from favorites" />

    <ImageView
        android:id="@+id/ivFavoriteImage"
        android:layout_width="0dp"
        android:layout_height="140dp"
        android:layout_marginTop="8dp"
        android:contentDescription="Product Image"
        android:scaleType="centerInside"
        android:src="@android:drawable/ic_menu_gallery"
        android:background="#CCCCCC"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivFavoriteUserIcon" />

    <TextView
        android:id="@+id/tvFavoriteName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:text="Product Name"
        android:textColor="#000000"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/tvFavoritePrice"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivFavoriteImage" />

    <TextView
        android:id="@+id/tvFavoritePrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="₱1,299.00"
        android:textColor="#000000"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/tvFavoriteName"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvFavoriteName" />

    <TextView
        android:id="@+id/tvFavoriteDesc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Product description goes here"
        android:textColor="#666666"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvFavoriteName" />

</androidx.constraintlayout.widget.ConstraintLayout>