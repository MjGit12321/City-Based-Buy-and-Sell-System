<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/inboxItemContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:padding="16dp">

    <ImageView
        android:id="@+id/ivInboxProfile"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:background="@drawable/circle_outline_bg"
        android:padding="4dp"
        android:src="@drawable/ic_user"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:contentDescription="User Profile" />

    <TextView
        android:id="@+id/tvInboxName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:text="User Name"
        android:textColor="#000000"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/tvInboxDate"
        app:layout_constraintStart_toEndOf="@id/ivInboxProfile"
        app:layout_constraintTop_toTopOf="@id/ivInboxProfile" />

    <TextView
        android:id="@+id/tvInboxLastMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Last message preview goes here..."
        android:textColor="#666666"
        android:textSize="14sp"
        app:layout_constraintEnd_toStartOf="@id/tvInboxUnread"
        app:layout_constraintStart_toStartOf="@id/tvInboxName"
        app:layout_constraintTop_toBottomOf="@id/tvInboxName" />

    <TextView
        android:id="@+id/tvInboxDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="7/26"
        android:textColor="#888888"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvInboxName" />

    <TextView
        android:id="@+id/tvInboxUnread"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/unread_badge_bg"
        android:gravity="center"
        android:text="1"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvInboxDate"
        tools:visibility="visible" />

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="#EEEEEE"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/tvInboxName"
        app:layout_constraintTop_toBottomOf="@id/ivInboxProfile" />

</androidx.constraintlayout.widget.ConstraintLayout>